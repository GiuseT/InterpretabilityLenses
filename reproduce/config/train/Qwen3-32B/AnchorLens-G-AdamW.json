{
    "model": {
        "name_or_path": "Qwen/Qwen3-32B",
        "device_map": "cuda:0"
    },
    "optimizer": {
        "optimizer": "AdamW",
        "lr_scale": 1.0,
        "warmup_steps": 25
    },
    "dataset": {
